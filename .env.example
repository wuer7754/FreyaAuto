PORT=3000

# Use a long random value in production. Generate one with: openssl rand -hex 48
TEAM_SESSION_SECRET=replace-with-a-long-random-secret

ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=https://api.freya-auto.com/oauth/etsy/callback
ETSY_SCOPES=listings_r listings_w shops_r
ETSY_MARKET_COUNTRY=US
ETSY_MARKET_CURRENCY=USD
ETSY_PROXY_URL=
OPENAI_API_KEY=
OPENAI_PROXY_URL=
# Optional Responses model that orchestrates the image-generation tool.
OPENAI_SOCIAL_IMAGE_MODEL=gpt-5.6

# Social publisher through Buffer. Create a personal key at:
# https://publish.buffer.com/settings/api
BUFFER_API_KEY=

# Optional. Leave blank to use the first matching Buffer workspace/channel.
BUFFER_ORGANIZATION_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_PINTEREST_CHANNEL_ID=
BUFFER_PINTEREST_BOARD_ID=

# Public HTTPS origin used by Buffer to download uploaded images.
SOCIAL_MEDIA_PUBLIC_BASE_URL=https://images.freya-auto.com

# Cloudflare R2 credentials scoped only to the freya-social-images bucket.
# Create them in Cloudflare R2 → Manage API Tokens. Never commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=freya-social-images
